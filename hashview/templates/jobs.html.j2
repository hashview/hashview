{% extends "layout.html.j2" %}
{% from "icons.html.j2" import icon %}
{% from "macros.html.j2" import status_badge, priority_pips %}
{% block title %}Jobs · Hashview{% endblock %}
{% block content %}
{% macro kv_label(t) -%}<div class="mono" style="font-size:9.5px; letter-spacing:1px; text-transform:uppercase; color:var(--text-mute); margin-bottom:6px;">{{ t }}</div>{%- endmacro %}

<div class="page-head">
    <div>
        <h1 class="page-title">Jobs</h1>
        <div class="page-sub">// {{ pagination.total | commafy }} jobs total · page {{ pagination.page }}/{{ pagination.pages or 1 }}</div>
    </div>
    <div style="display:flex; gap:10px;">
        {% if show_only_mine == 'true' %}
            <a class="btn active" href="{{ url_for('jobs.jobs_list', show_only_mine='false', page=1, q=name_filter) }}">{{ icon('users', size=15) }} All jobs</a>
        {% else %}
            <a class="btn" href="{{ url_for('jobs.jobs_list', show_only_mine='true', page=1, q=name_filter) }}">{{ icon('users', size=15) }} Only mine</a>
        {% endif %}
        <a class="btn btn-primary" href="{{ url_for('jobs.jobs_add') }}">{{ icon('plus', size=15) }} New Job</a>
    </div>
</div>

<div class="card">
    <div class="card-head" style="justify-content:flex-end;">
        {# Server-side filter: submits so it searches every job, not just this page. #}
        <form method="GET" action="{{ url_for('jobs.jobs_list') }}" style="display:flex; align-items:center; gap:8px; margin:0;">
            <input type="hidden" name="show_only_mine" value="{{ show_only_mine }}">
            <span style="color:var(--text-mute); display:inline-flex;">{{ icon('search', size=16) }}</span>
            <input type="text" id="job-filter" name="q" value="{{ name_filter }}" class="input" style="width:260px; flex:none;" placeholder="filter jobs…" autocomplete="off">
            {% if name_filter %}
            <a class="icon-btn" href="{{ url_for('jobs.jobs_list', show_only_mine=show_only_mine) }}" title="Clear filter">{{ icon('x', size=15) }}</a>
            {% endif %}
        </form>
    </div>
    {% if jobs %}
    <div class="job-bulkbar" id="job-bulkbar">
        <span class="job-sel-count"><span id="job-sel-count">0</span> selected</span>
        <span style="flex:1;"></span>
        <button type="button" class="btn" onclick="hvJobClearSel()">Clear</button>
        <button type="button" class="btn btn-danger" onclick="hvJobOpenBulkDel()">{{ icon('trash', size=15) }} Delete selected</button>
    </div>
    <table class="tbl">
        <thead>
            <tr>
                <th style="width:34px; text-align:center;"><input type="checkbox" class="hv-check" id="job-select-all" onclick="hvJobToggleAll(this)" title="Select all deletable jobs"></th><th>Job</th><th>Customer</th><th>Hashfile</th>
                <th class="center">Status</th><th class="center">Cracked</th><th class="center">Priority</th>
                <th>Owner</th><th>Created</th><th class="center" style="width:180px;">Control</th>
            </tr>
        </thead>
        <tbody id="job-tbody">
            {% for job in jobs %}
            {% set ns = namespace(cust='', hf='', owner='') %}
            {% for c in customers %}{% if c.id == job.customer_id %}{% set ns.cust = c.name %}{% endif %}{% endfor %}
            {% for h in hashfiles %}{% if h.id == job.hashfile_id %}{% set ns.hf = h.name %}{% endif %}{% endfor %}
            {% for u in users %}{% if u.id == job.owner_id %}{% set ns.owner = u.first_name ~ ' ' ~ u.last_name %}{% endif %}{% endfor %}
            <tr data-name="{{ job.name|lower }} {{ ns.cust|lower }}">
                <td class="center">
                    {% set can_del = (current_user.admin or job.owner_id == current_user.id) and job.status not in ['Running', 'Queued'] %}
                    {% if can_del %}
                    <input type="checkbox" class="hv-check job-check" value="{{ job.id }}" data-name="{{ job.name }}" data-customer="{{ ns.cust }}" onchange="hvJobSelChanged()">
                    {% elif job.status in ['Running', 'Queued'] %}
                    <span class="job-lock" title="{{ job.status }} — stop the job before deleting">{{ icon('lock', size=15) }}</span>
                    {% endif %}
                </td>
                <td style="font-weight:500;"><div title="{{ job.name }}" style="max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ job.name }}</div></td>
                <td style="color:var(--text-dim);"><div title="{{ ns.cust }}" style="max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ ns.cust }}</div></td>
                <td class="mono" style="color:var(--text-dim);"><div title="{{ ns.hf }}" style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ ns.hf }}</div></td>
                <td class="center">{{ status_badge(job.status) }}</td>
                <td class="center">
                    {% set cr = job_cracked.get(job.id) if job_cracked is defined else none %}
                    {% if cr and cr.total %}
                    <div class="mono num" style="font-size:12.5px;white-space:nowrap;">
                        <span style="color:{{ 'var(--primary)' if cr.cracked else 'var(--text-dim)' }};{% if cr.cracked %}text-shadow:var(--glow-text);{% endif %}"><a class="rec-x-link" href="{{ url_for('analytics.get_analytics', customer_id=job.customer_id, hashfile_id=job.hashfile_id) }}" title="View hashfile analytics">{{ "{:,}".format(cr.cracked) }}</a></span><span style="color:var(--text-mute);">/{{ "{:,}".format(cr.total) }}</span>
                    </div>
                    <div style="height:3px;width:84px;margin:6px auto 0;border-radius:2px;background:var(--surface-3);overflow:hidden;">
                        <div style="height:100%;width:{{ cr.pct }}%;background:linear-gradient(90deg,var(--primary-deep),var(--primary));box-shadow:var(--glow-sm);"></div>
                    </div>
                    {% else %}
                    <span style="color:var(--text-mute);">—</span>
                    {% endif %}
                </td>
                <td class="center">{{ priority_pips(job.priority) }}</td>
                <td class="mono" style="color:var(--text-dim);"><div title="{{ ns.owner }}" style="max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ ns.owner }}</div></td>
                <td class="mono" style="color:var(--text-mute);font-size:11.5px;">{{ job.created_at.strftime('%b %d %H:%M') if job.created_at else '—' }}</td>
                <td class="center">
                    <div style="display:flex; gap:4px; justify-content:flex-end;">
                        {% if job.status == 'Ready' %}
                            <form method="POST" action="{{ url_for('jobs.jobs_start', job_id=job.id) }}" style="display:contents">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" class="icon-btn act-go" title="Start">{{ icon('play', size=15) }}</button>
                            </form>
                        {% elif job.status == 'Queued' or job.status == 'Running' %}
                            <form method="POST" action="{{ url_for('jobs.jobs_stop', job_id=job.id) }}" style="display:contents">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" class="icon-btn act-stop" title="Stop">{{ icon('stop', size=15) }}</button>
                            </form>
                        {% elif job.status == 'Canceled' %}
                            <form method="POST" action="{{ url_for('jobs.jobs_start', job_id=job.id) }}" style="display:contents">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" class="icon-btn act-go" title="Restart">{{ icon('refresh', size=15) }}</button>
                            </form>
                        {% endif %}
                        {% if job.status != 'Incomplete' %}
                            <a class="icon-btn" href="{{ url_for('analytics.get_analytics', customer_id=job.customer_id, hashfile_id=job.hashfile_id) }}" title="Analytics">{{ icon('chart', size=15) }}</a>
                            <button type="button" class="icon-btn" title="Info" onclick="document.getElementById('info-{{ job.id }}').showModal()">{{ icon('info', size=15) }}</button>
                        {% endif %}
                        {% if job.status == 'Running' or job.status == 'Queued' %}
                            <span class="icon-btn" style="opacity:.4; cursor:not-allowed;" title="Locked while active">{{ icon('edit', size=15) }}</span>
                        {% else %}
                            <a class="icon-btn" href="{{ url_for('jobs.jobs_assigned_hashfile', job_id=job.id) }}" title="Edit">{{ icon('edit', size=15) }}</a>
                        {% endif %}
                        <button type="button" class="icon-btn act-del" title="Delete" onclick="document.getElementById('del-{{ job.id }}').showModal()">{{ icon('trash', size=15) }}</button>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% elif name_filter %}
    <div class="card-body" style="text-align:center; padding:48px 24px;">
        <div class="mono" style="color:var(--text-dim); margin-bottom:14px;">No jobs match &ldquo;{{ name_filter }}&rdquo;.</div>
        <a class="btn" href="{{ url_for('jobs.jobs_list', show_only_mine=show_only_mine) }}">Clear filter</a>
    </div>
    {% else %}
    <div class="card-body" style="text-align:center; padding:48px 24px;">
        <div class="mono" style="color:var(--text-dim); margin-bottom:14px;">No jobs found.</div>
        <a class="btn btn-primary" href="{{ url_for('jobs.jobs_add') }}">{{ icon('plus', size=15) }} Create a New Job</a>
    </div>
    {% endif %}
</div>

{% if pagination.pages and pagination.pages > 1 %}
<div class="pager">
    {% if pagination.has_prev %}
        <a class="pager-btn" href="{{ url_for('jobs.jobs_list', page=pagination.prev_num, show_only_mine=show_only_mine, q=name_filter) }}">‹ Prev</a>
    {% else %}
        <span class="pager-btn disabled">‹ Prev</span>
    {% endif %}
    {% for p in pagination.iter_pages(left_edge=2, right_edge=2, left_current=2, right_current=2) %}
        {% if p %}
            {% if p == pagination.page %}
                <span class="pager-btn active">{{ p }}</span>
            {% else %}
                <a class="pager-btn" href="{{ url_for('jobs.jobs_list', page=p, show_only_mine=show_only_mine, q=name_filter) }}">{{ p }}</a>
            {% endif %}
        {% else %}
            <span class="pager-btn disabled">…</span>
        {% endif %}
    {% endfor %}
    {% if pagination.has_next %}
        <a class="pager-btn" href="{{ url_for('jobs.jobs_list', page=pagination.next_num, show_only_mine=show_only_mine, q=name_filter) }}">Next ›</a>
    {% else %}
        <span class="pager-btn disabled">Next ›</span>
    {% endif %}
</div>
{% endif %}

{# ---- per-job modals (native <dialog>, no framework) ---- #}
{% for job in jobs %}
<dialog class="hv-dialog" id="info-{{ job.id }}" style="max-width:680px; width:94vw;">
    {% set cr = job_cracked.get(job.id) if job_cracked is defined else none %}
    <div class="hv-dialog-head">
        {{ icon('info', size=16) }}
        <div style="line-height:1.2;">
            <h3 style="margin:0;">{{ job.name }}</h3>
            <div class="mono" style="font-size:10px; letter-spacing:0.5px; color:var(--text-mute); margin-top:3px;">job #{{ job.id }} · {% for c in customers %}{% if c.id == job.customer_id %}{{ c.name }}{% endif %}{% endfor %}</div>
        </div>
        <button class="icon-btn" onclick="this.closest('dialog').close()" aria-label="Close">{{ icon('x', size=15) }}</button>
    </div>
    <div class="hv-dialog-body" style="max-height:72vh; overflow-y:auto;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
            {{ status_badge(job.status) }}
            <span class="mono" style="font-size:12.5px;">{% if cr %}<span style="color:var(--text);">{% if job.hashfile_id %}<a class="rec-x-link" href="{{ url_for('analytics.get_analytics', customer_id=job.customer_id, hashfile_id=job.hashfile_id) }}" title="View hashfile analytics">{{ "{:,}".format(cr.cracked) }}</a>{% else %}{{ "{:,}".format(cr.cracked) }}{% endif %}</span><span style="color:var(--text-mute);"> / {{ "{:,}".format(cr.total) }} hashes recovered</span>{% endif %}</span>
            <span style="margin-left:auto; display:inline-block; text-align:center; line-height:1;">
                <span class="mono" style="font-size:24px; color:var(--primary); text-shadow:var(--glow-text);">{{ cr.pct if cr else 0 }}<span style="font-size:12px;">%</span></span>
                <span class="mono" style="display:block; font-size:9px; letter-spacing:1px; color:var(--text-mute); margin-top:2px;">CRACKED</span>
            </span>
        </div>
        <div style="height:4px; border-radius:2px; background:var(--surface-3); overflow:hidden; margin-bottom:20px;">
            <div style="height:100%; width:{{ cr.pct if cr else 0 }}%; background:linear-gradient(90deg,var(--primary-deep),var(--primary)); box-shadow:var(--glow-sm);"></div>
        </div>

        <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 18px 24px;">
            <div>{{ kv_label('Customer') }}<div style="color:var(--text);">{% for c in customers %}{% if c.id == job.customer_id %}{{ c.name }}{% endif %}{% endfor %}</div></div>
            <div>{{ kv_label('Owner') }}<div style="color:var(--text); display:inline-flex; align-items:center; gap:7px;">{{ icon('users', size=14) }}{% for u in users %}{% if u.id == job.owner_id %}{{ u.first_name }} {{ u.last_name }}{% endif %}{% endfor %}</div></div>
            <div>{{ kv_label('Hashfile') }}<div class="mono" style="color:var(--text);">{% for h in hashfiles %}{% if h.id == job.hashfile_id %}{{ h.name }}{% endif %}{% endfor %}{% if not job.hashfile_id %}<span style="color:var(--text-mute);">—</span>{% endif %}</div></div>
            <div>{{ kv_label('Hash type') }}<div>{% if job_hash_type is defined and job_hash_type.get(job.id) %}<span class="badge cyan">{{ job_hash_type[job.id] }}</span>{% else %}<span style="color:var(--text-mute);">—</span>{% endif %}</div></div>
            <div>{{ kv_label('Priority') }}<div style="display:inline-flex; align-items:center; gap:9px;">{{ priority_pips(job.priority) }}<span class="mono" style="color:var(--text-dim);">{{ job.priority }}/5</span></div></div>
            <div>{{ kv_label('Tasks') }}{% set tc = job_task_count.get(job.id, 0) if job_task_count is defined else 0 %}<div style="color:var(--text);">{{ tc | commafy }} attack{{ '' if tc == 1 else 's' }} queued</div></div>
            <div>{{ kv_label('Started') }}<div class="mono" style="color:var(--text);">{{ job.started_at.strftime('%b %d %H:%M') if job.started_at else 'Not started' }}</div></div>
            <div>{{ kv_label('Runtime') }}<div class="mono" style="color:var(--text);">{{ job_runtime.get(job.id, '-') if job_runtime is defined else '-' }}</div></div>
        </div>

        <div style="margin-top:20px;">
            {{ kv_label('Notifications') }}
            {% set nf = job_notifs.get(job.id) if job_notifs is defined else none %}
            {% if nf and (nf.email or nf.pushover or nf.per_hash) %}
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                {% if nf.email %}<span class="badge green">{{ icon('mail', size=12) }} EMAIL ON COMPLETION</span>{% endif %}
                {% if nf.pushover %}<span class="badge green">{{ icon('bell', size=12) }} PUSHOVER ON COMPLETION</span>{% endif %}
                {% if nf.per_hash %}<span class="badge green">{{ icon('key', size=12) }} PER-HASH ALERTS</span>{% endif %}
            </div>
            {% else %}
            <div class="mono" style="color:var(--text-mute);">none configured</div>
            {% endif %}
        </div>
    </div>
    <div class="hv-dialog-foot">
        <span class="mono" style="font-size:11.5px; color:var(--text-mute); margin-right:auto;">created {{ job.created_at.strftime('%b %d %H:%M') if job.created_at else '—' }}</span>
        <button class="btn" onclick="this.closest('dialog').close()">Close</button>
        <a class="btn btn-primary" href="{{ url_for('jobs.jobs_list_tasks', job_id=job.id) }}" role="button">{{ icon('arrowRight', size=15) }} Open job</a>
    </div>
</dialog>

<dialog class="hv-dialog" id="del-{{ job.id }}">
    <div class="hv-dialog-head"><h3>Delete {{ job.name }}?</h3><button class="icon-btn" onclick="this.closest('dialog').close()" aria-label="Close">{{ icon('x', size=15) }}</button></div>
    <div class="hv-dialog-body">This will permanently delete the job. Are you sure you want to continue?</div>
    <div class="hv-dialog-foot">
        <button class="btn" onclick="this.closest('dialog').close()">Back</button>
        <form action="{{ url_for('jobs.jobs_delete', job_id=job.id) }}" method="POST" style="display:inline;">
            <button class="btn btn-danger" type="submit">Delete</button>
        </form>
    </div>
</dialog>
{% endfor %}

{# ---- bulk-delete confirmation (one modal for the whole selected set) ---- #}
<dialog class="hv-dialog" id="job-bulk-del-modal" style="max-width:620px; width:94vw;">
    <div class="hv-dialog-head">
        <span style="color:var(--red); display:inline-flex;">{{ icon('trash', size=16) }}</span>
        <div style="line-height:1.2;">
            <h3 style="margin:0;" id="job-bulk-title">Delete jobs?</h3>
            <div class="mono" style="font-size:10px; letter-spacing:0.5px; text-transform:uppercase; color:var(--text-mute); margin-top:3px;">this permanently removes the jobs and their task queue</div>
        </div>
        <button class="icon-btn" onclick="this.closest('dialog').close()" aria-label="Close" style="margin-left:auto;">{{ icon('x', size=15) }}</button>
    </div>
    <div class="hv-dialog-body" style="max-height:52vh; overflow-y:auto;">
        <div class="mono" style="font-size:11px; color:var(--text-mute); margin-bottom:10px;">The following will be permanently deleted:</div>
        <div id="job-bulk-list"></div>
    </div>
    <div class="hv-dialog-foot">
        <button class="btn" onclick="this.closest('dialog').close()">Cancel</button>
        <form id="job-bulk-form" action="{{ url_for('jobs.jobs_bulk_delete') }}" method="POST" style="display:inline;">
            <span id="job-bulk-hidden"></span>
            <button type="submit" class="btn btn-danger">{{ icon('trash', size=15) }} Delete <span id="job-bulk-btn-count">0</span></button>
        </form>
    </div>
</dialog>

<script>
// ---- bulk selection + bulk delete (jobs list) ----
var JOB_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-mute); flex:none;"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>';
function hvJobSelected(){
    return Array.prototype.slice.call(document.querySelectorAll('.job-check:checked'));
}
function hvJobSelChanged(){
    var n = hvJobSelected().length;
    var all = document.querySelectorAll('.job-check').length;
    var cEl = document.getElementById('job-sel-count'); if (cEl) cEl.textContent = n;
    var bar = document.getElementById('job-bulkbar'); if (bar) bar.classList.toggle('on', n > 0);
    var sa = document.getElementById('job-select-all');
    if (sa) { sa.checked = n > 0 && n === all; sa.indeterminate = n > 0 && n < all; }
}
function hvJobToggleAll(cb){
    document.querySelectorAll('.job-check').forEach(function(c){ c.checked = cb.checked; });
    hvJobSelChanged();
}
function hvJobClearSel(){
    document.querySelectorAll('.job-check').forEach(function(c){ c.checked = false; });
    hvJobSelChanged();
}
function hvJobOpenBulkDel(){
    var sel = hvJobSelected();
    if (!sel.length) return;
    var list = document.getElementById('job-bulk-list');
    var hidden = document.getElementById('job-bulk-hidden');
    list.innerHTML = ''; hidden.innerHTML = '';
    sel.forEach(function(c){
        var row = document.createElement('div');
        row.className = 'job-bulk-row';
        var ico = document.createElement('span');
        ico.style.cssText = 'display:inline-flex; flex:none;';
        ico.innerHTML = JOB_ICON;                       // static markup, safe
        var name = document.createElement('span');
        name.className = 'mono'; name.style.color = 'var(--text)';
        name.textContent = c.getAttribute('data-name') || '';   // textContent — XSS-safe
        var meta = document.createElement('span');
        meta.style.color = 'var(--text-mute)';
        var cust = c.getAttribute('data-customer') || '';
        meta.textContent = cust ? ' · ' + cust : '';
        row.appendChild(ico); row.appendChild(name); row.appendChild(meta);
        list.appendChild(row);
        var inp = document.createElement('input');
        inp.type = 'hidden'; inp.name = 'job_ids'; inp.value = c.value;
        hidden.appendChild(inp);
    });
    var n = sel.length;
    document.getElementById('job-bulk-title').textContent =
        'Delete ' + n + ' job' + (n === 1 ? '' : 's') + '?';
    document.getElementById('job-bulk-btn-count').textContent = n;
    var m = document.getElementById('job-bulk-del-modal');
    try { m.showModal(); } catch (e) { m.setAttribute('open', ''); }
}
</script>

<style>
.job-bulkbar { display:none; align-items:center; gap:12px; margin:0 16px 14px; padding:11px 16px;
    border:1px solid var(--primary-dim); border-radius:10px; background:rgba(var(--primary-rgb),0.07); box-shadow:var(--glow-sm); }
.job-bulkbar.on { display:flex; }
.job-sel-count { color:var(--primary); text-shadow:var(--glow-text); font-family:var(--mono); font-size:13px; letter-spacing:.3px; }
.job-lock { color:var(--text-mute); display:inline-flex; }
.job-bulk-row { display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-soft); }
.job-bulk-row:last-child { border-bottom:none; }
</style>

{% endblock %}
