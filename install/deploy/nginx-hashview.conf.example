# Hashview — nginx TLS-terminating reverse proxy (RECOMMENDED production setup).
#
# Terminates HTTPS on the SAME public port Hashview used directly (8443) and
# proxies to the app running `hashview.py --no-ssl` on 127.0.0.1:5000. Keeping
# 8443 means agents (which use verify=False and an operator-set port), browsers
# (https://FQDN:8443), Flask's SERVER_NAME=FQDN:8443, and the Entra/Azure SSO
# redirect all keep working with ZERO reconfiguration.
#
# Why this instead of the built-in TLS: Werkzeug terminates TLS inline on its one
# accept thread, so a single stalled client freezes every new connection. nginx
# owns TLS, concurrency, and half-open-connection timeouts; the app serves plain
# HTTP on loopback. See hashview/utils/tls.py.
#
# Install:
#   RHEL/Rocky:    copy to /etc/nginx/conf.d/hashview.conf
#   Debian/Ubuntu: copy to /etc/nginx/sites-available/hashview and symlink it
#                  into /etc/nginx/sites-enabled/
#   then edit server_name + the two ssl_certificate* paths, and:
#       nginx -t && systemctl reload nginx
#
# App side: set `behind_proxy = true` in hashview/config.conf and run the app
# with `hashview.py --no-ssl` (binds 127.0.0.1:5000 by default).

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;                      # browsers get HTTP/2; agents use HTTP/1.1, unaffected

    server_name FQDN;              # EDIT: the host part of SERVER_NAME, e.g. hashview.example.com

    # --- TLS: reuse the EXISTING self-signed cert generated by setup.py ---------
    # EDIT: absolute paths to your Hashview checkout's cert pair
    #       (<hashview repo>/hashview/ssl/cert.pem and key.pem).
    # To drop browser warnings, swap in a CA-signed cert + key here; nothing else
    # in Hashview changes (agents use verify=False) and `systemctl reload nginx`.
    ssl_certificate     /opt/hashview/hashview/ssl/cert.pem;
    ssl_certificate_key /opt/hashview/hashview/ssl/key.pem;

    # --- Modern-but-not-brittle TLS policy -------------------------------------
    ssl_protocols       TLSv1.2 TLSv1.3;     # drop TLS 1.0/1.1; keep 1.2 for older agents
    ssl_prefer_server_ciphers off;           # let TLS 1.3 clients choose; harmless for 1.2
    ssl_session_cache   shared:HashviewTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- HSTS: now the proxy's job (the app emits none) ------------------------
    # Only effective once a CA-signed cert is installed: browsers ignore (and will
    # not store) HSTS received over a connection with certificate errors, so with
    # the default self-signed cert this header is harmless but inert. Uncomment
    # after installing a trusted cert.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Large uploads: stream to the app, never cap or buffer -----------------
    # Hashview streams multi-GB wordlist/hashfile uploads to disk; a body cap or
    # request buffering here would reintroduce the exact RAM/disk blow-up that was
    # fixed. BOTH directives are required (a cap 413s; buffering spools to nginx).
    client_max_body_size 0;          # no size limit -> no 413 on multi-GB uploads
    proxy_request_buffering off;      # stream the request body straight to the app
    client_body_timeout   3600s;      # max GAP between body packets (not total time)
    client_header_timeout 60s;

    # --- Large downloads: don't spool multi-GB responses to nginx temp files ---
    proxy_buffering off;
    proxy_max_temp_file_size 0;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;          # enables chunked request bodies for streamed uploads
        proxy_set_header Connection "";

        # Preserve the client's Host so Flask's SERVER_NAME=FQDN:8443 still matches.
        # (If clients may reach the server by IP, hardcode the name instead so the
        #  match is guaranteed. Pin BOTH Host and X-Forwarded-Host -- the app's
        #  ProxyFix x_host=1 replaces Host with X-Forwarded-Host, so pinning Host
        #  alone still hands Flask the IP:
        #      proxy_set_header Host             FQDN:8443;
        #      proxy_set_header X-Forwarded-Host FQDN;          )
        proxy_set_header Host              $host;

        # Forwarded headers for the app's behind_proxy mode (ProxyFix). set_header
        # OVERWRITES any client-supplied value, so Proto/Host/Port cannot be
        # spoofed. For X-Forwarded-For we send ONLY the real peer ($remote_addr),
        # ignoring any client-sent chain -- correct for a single proxy hop and the
        # app's x_for=1. If you later add a trusted upstream load balancer, switch
        # this to `$proxy_add_x_forwarded_for` and bump the app's x_for count.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  8443;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;

        # Long requests: keyspace measurement (minutes), big downloads, dynamic
        # wordlist generation. These bound the GAP between bytes, not the whole
        # transfer, so a long-but-progressing transfer is never cut off.
        proxy_connect_timeout 60s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
    }
}
