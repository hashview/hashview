{# Running-job cards + queue table. Rendered on the full dashboard and re-rendered
   by /dashboard/jobs. Styling (.rj-tasks, .queue-tbl) lives in home.html.j2 so it
   is not re-injected on every poll. #}
{% from "icons.html.j2" import icon %}
{% from "macros.html.j2" import status_badge, priority_pips %}
{% if not running_jobs and not queued_jobs %}
    <div class="card" style="margin-top:6px;">
        <div class="card-body" style="text-align:center;padding:48px 24px;">
            <div class="mono" style="color:var(--text-dim);margin-bottom:14px;">No configured jobs.</div>
            <a class="btn btn-primary" href="{{ url_for('jobs.jobs_add') }}">{{ icon('plus', size=15) }} Create a New Job</a>
        </div>
    </div>
{% else %}

    {% if running_jobs %}
    <div class="term-divider">running jobs</div>
    <div style="margin-top:14px;">
        {% for job in running_jobs %}
            {% set d = (job_dash.get(job.id) if job_dash is defined else none) or {'groups': [], 'hashfile_total': 0, 'tasks_total': 0, 'tasks_done': 0, 'tasks_running': 0, 'chunks_total': 0, 'chunks_done': 0, 'chunks_active': 0} %}
            {% if job.started_at %}
                {% set job_elapsed = (datetime.now() - job.started_at).total_seconds() %}
                {% set job_remaining = (settings.max_runtime_jobs * 3600 - job_elapsed) if settings and settings.max_runtime_jobs else 0 %}
                {% set job_remaining_abs = job_remaining if job_remaining > 0 else 0 %}
            {% endif %}
            <details class="card job-card" data-job-id="{{ job.id }}" open>
                <summary class="card-head">
                    <span class="dot-led run"></span>
                    <div style="min-width:0;">
                        <div style="font-size:14px;color:var(--text);font-weight:600;">
                            <span style="color:var(--text-dim);">{% for c in customers %}{% if c.id == job.customer_id %}{{ c.name }}{% endif %}{% endfor %} /</span> {{ job.name }}
                        </div>
                        <div class="mono" style="font-size:10.5px;color:var(--text-mute);margin-top:3px;">#{{ job.id }}{% for u in users %}{% if u.id == job.owner_id %} · owner {{ u.first_name }} {{ u.last_name }}{% endif %}{% endfor %}</div>
                    </div>
                    <div style="margin-left:auto;display:flex;align-items:center;gap:16px;">
                        {% if job.started_at %}
                        <div class="mono" style="font-size:11px;color:var(--text-dim);text-align:right;">
                            <div>elapsed <b style="color:var(--text);">{{ (job_elapsed // 3600)|int }}h {{ ((job_elapsed % 3600)//60)|int }}m</b></div>
                            <div style="margin-top:2px;">left <b style="color:var(--amber);">{% if settings and settings.max_runtime_jobs %}{{ (job_remaining_abs // 3600)|int }}h {{ ((job_remaining_abs % 3600)//60)|int }}m{% else %}N/A{% endif %}</b></div>
                        </div>
                        {% endif %}
                        {{ icon('chevR', cls='ico chev') }}
                    </div>
                </summary>
                <div class="card-body">
                    <div style="display:flex;justify-content:space-between;font-size:11px;font-family:var(--mono);color:var(--text-dim);margin-bottom:7px;">
                        <span>{{ d.tasks_done }}/{{ d.tasks_total }} tasks complete{% if d.ks_total %} · {{ d.ks_done|human_count }}/{{ d.ks_total|human_count }} keyspace{% endif %}{% if d.tasks_measuring %} · {{ d.tasks_measuring }} measuring{% endif %}</span>
                        <span>{{ d.tasks_running }} running · {{ d.chunks_active|commafy }} chunks in flight</span>
                    </div>
                    {# Keyspace, not a chunk count: slices are issued on demand, so a
                       row count grows through the run and a bar built from it snaps
                       toward 100% then jumps backwards. #}
                    <div class="progress">
                        {% if d.ks_total %}
                        <div class="seg-done" style="width: {{ (d.ks_done / d.ks_total) * 100 }}%"></div>
                        <div class="seg-run" style="width: {{ (d.ks_running / d.ks_total) * 100 }}%"></div>
                        {% elif d.chunks_total %}
                        <div class="seg-done" style="width: {{ (d.chunks_done / d.chunks_total) * 100 }}%"></div>
                        <div class="seg-run" style="width: {{ (d.chunks_active / d.chunks_total) * 100 }}%"></div>
                        {% endif %}
                    </div>
                    <table class="tbl rj-tasks" style="margin-top:16px;">
                        <thead><tr><th style="width:30px;"></th><th>Task</th><th class="center">Status</th><th>Agent</th><th>Keyspace</th><th class="center">Recovered</th><th class="center">Rate</th><th class="center">ETA</th>{% if settings and settings.max_runtime_tasks %}<th class="center" title="Time left before Settings &gt; max runtime cancels this attack">Auto-cancel</th>{% endif %}<th></th></tr></thead>
                        <tbody>
                            {% for g in d.groups %}
                                {# Keyed on the ATTACK, not the task: two assignments of one dynamic-wordlist
   task collide on task_id, and the expander state has to survive the 20s
   poll replacing the child rows underneath it. #}
                                {% set key = job.id ~ ':' ~ g.entry_id %}
                                <tr class="task-row" data-task-key="{{ key }}">
                                    <td class="center">
                                        {% if g.expandable %}
                                        <button type="button" class="chunk-toggle" data-key="{{ key }}" title="Show active chunks" onclick="toggleChunks('{{ key }}', this)">{{ icon('chevR', size=14) }}</button>
                                        {% else %}
                                        <span class="chunk-toggle disabled" title="No active chunks">{{ icon('chevR', size=14) }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="mono">{{ g.name }}</div>
                                        {% if g.attack %}<div class="mono" style="font-size:10px;color:var(--text-mute);margin-top:2px;">{{ g.attack }}</div>{% endif %}
                                    </td>
                                    <td class="center">{{ status_badge(g.status) }}</td>
                                    <td class="mono" style="color:var(--text-dim);">{% if g.agent_display %}{{ g.agent_display }}{% else %}<span class="dash">—</span>{% endif %}</td>
                                    <td style="min-width:160px;">
                                        <div style="display:flex;justify-content:space-between;font-size:10px;font-family:var(--mono);color:var(--text-dim);margin-bottom:4px;">
                                            <span>{% if g.ks_total %}{{ g.ks_done|human_count }}/{{ g.ks_total|human_count }}{% elif g.status == 'Measuring' %}measuring…{% else %}{{ g.completed|commafy }}/{{ g.total|commafy }} chunks{% endif %}</span>
                                            {% if g.running %}<span style="color:var(--amber);">{{ g.running }} in flight</span>{% endif %}
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            {% if g.ks_total %}
                                            <div class="seg-done" style="width: {{ (g.ks_done / g.ks_total) * 100 }}%"></div>
                                            <div class="seg-run" style="width: {{ (g.ks_running / g.ks_total) * 100 }}%"></div>
                                            {% elif g.total %}
                                            <div class="seg-done" style="width: {{ (g.completed / g.total) * 100 }}%"></div>
                                            <div class="seg-run" style="width: {{ (g.running / g.total) * 100 }}%"></div>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="center num">{% if job.hashfile_id %}<a class="rec-x-link" href="{{ url_for('analytics.get_analytics', customer_id=job.customer_id, hashfile_id=job.hashfile_id) }}" title="View hashfile analytics"><span style="color:{{ 'var(--primary)' if g.recovered else 'var(--text-mute)' }};">{{ g.recovered|commafy }}</span><span style="color:var(--text-mute);">/{{ d.hashfile_total|commafy }}</span></a>{% else %}<span style="color:{{ 'var(--primary)' if g.recovered else 'var(--text-mute)' }};">{{ g.recovered|commafy }}</span><span style="color:var(--text-mute);">/{{ d.hashfile_total|commafy }}</span>{% endif %}</td>
                                    <td class="center num" style="color:var(--text-dim);">{% if g.rate %}{{ g.rate }}{% else %}<span class="dash">—</span>{% endif %}</td>
                                    <td class="center num" style="color:{{ 'var(--amber)' if g.eta else 'var(--text-mute)' }};">{% if g.eta %}{{ g.eta }}{% else %}<span class="dash">—</span>{% endif %}</td>
                                    {% if settings and settings.max_runtime_tasks %}<td class="center num" style="color:{{ 'var(--red)' if g.cancel_in == '0s' else 'var(--text-dim)' }};">{% if g.cancel_in %}{{ g.cancel_in }}{% else %}<span class="dash">—</span>{% endif %}</td>{% endif %}
                                    <td class="center">{% if g.status == 'Running' %}<a class="icon-btn" href="{{ url_for('main.stop_task', job_id=job.id, task_id=g.task_id) }}" title="Stop task">{{ icon('stop', size=15) }}</a>{% endif %}</td>
                                </tr>
                                {% if g.expandable %}
                                    {% for ch in g.active_chunks %}
                                    <tr class="chunk-row" data-parent="{{ key }}" hidden>
                                        <td></td>
                                        {# Which PIECE of the task this row is -- a continuation of the
                                           task name above it, so it sits under Task, indented. Spelled
                                           out ("Chunk #3") rather than a bare "#3", which read as an id
                                           of something unstated. #}
                                        <td class="mono" style="color:var(--text-dim); padding-left:28px;">{% if ch.chunk_no %}Chunk {{ ch.label }}{% if ch.chunk_total and ch.chunk_total > 0 %}<span style="color:var(--text-mute);">/{{ ch.chunk_total }}</span>{% endif %}{% else %}<span class="dash">—</span>{% endif %}</td>
                                        <td></td>
                                        <td class="mono" style="color:var(--text-dim);">{{ ch.agent }}</td>
                                        {# The chunk's own keyspace, under the Keyspace column where the
                                           parent task shows the attack's. #}
                                        <td class="mono" style="color:var(--text-dim);">{{ ch.keyspace }}</td>
                                        <td class="center num">{% if ch.recovered is not none %}{% if job.hashfile_id %}<a class="rec-x-link" href="{{ url_for('analytics.get_analytics', customer_id=job.customer_id, hashfile_id=job.hashfile_id) }}" title="View hashfile analytics"><span style="color:{{ 'var(--primary)' if ch.recovered else 'var(--text-mute)' }};">{{ ch.recovered|commafy }}</span><span style="color:var(--text-mute);">/{{ d.hashfile_total|commafy }}</span></a>{% else %}<span style="color:{{ 'var(--primary)' if ch.recovered else 'var(--text-mute)' }};">{{ ch.recovered|commafy }}</span><span style="color:var(--text-mute);">/{{ d.hashfile_total|commafy }}</span>{% endif %}{% else %}<span class="dash">—</span>{% endif %}</td>
                                        <td class="center num" style="color:var(--text-dim);">{% if ch.rate %}{{ ch.rate }}{% else %}<span class="dash">—</span>{% endif %}</td>
                                        <td class="center num" style="color:{{ 'var(--amber)' if ch.eta else 'var(--text-mute)' }};">{% if ch.eta %}{{ ch.eta }}{% else %}<span class="dash">—</span>{% endif %}</td>
                                        {% if settings and settings.max_runtime_tasks %}<td></td>{% endif %}
                                        <td></td>
                                    </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
        {% endfor %}
    </div>
    {% endif %}

    {% if queued_jobs %}
    <div class="term-divider" style="margin-top:18px;">queue · {{ queued_jobs|length }} pending</div>
    <div class="card" style="margin-top:14px;">
        <table class="tbl queue-tbl">
            <thead><tr><th>#</th><th>Job</th><th>Customer</th><th class="center">Tasks</th><th class="center">Priority</th><th>Owner</th></tr></thead>
            <tbody>
                {% for job in queued_jobs %}
                    {% set qt = namespace(v=attack_counts.get(job.id, 0) if attack_counts is defined else 0) %}
                    <tr>
                        <td class="mono" style="color:var(--text-mute);">{{ loop.index }}</td>
                        <td style="font-weight:500;">{{ job.name }}</td>
                        <td style="color:var(--text-dim);">{% for c in customers %}{% if c.id == job.customer_id %}{{ c.name }}{% endif %}{% endfor %}</td>
                        <td class="center num">{{ qt.v }}</td>
                        <td class="center">{{ priority_pips(job.priority) }}</td>
                        <td class="mono" style="color:var(--text-dim);">{% for u in users %}{% if u.id == job.owner_id %}{{ u.first_name }} {{ u.last_name }}{% endif %}{% endfor %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

{% endif %}
