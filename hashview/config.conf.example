[SERVER]
SERVER_NAME = FQDN:PORT
SECRET_KEY = change-me-to-a-random-string
# Byte cap on pasted (non-file) form fields, e.g. the pasted-hashes textarea
# on the job/hashfile upload pages. Raise this if operators need to paste more
# than ~500KB of hashes at once; there is no upper ceiling.
#
# The size of an *uploaded file* is not counted against this cap, so raising it
# is not needed for large hash files. But do NOT set it below 65536: Werkzeug
# also applies this limit to each 64KiB chunk it reads while parsing a
# multipart body, which rejects every file upload regardless of file size.
# Values under 65536 are therefore clamped up to it -- see
# hashview/form_limits.py.
#
# Defaults to 500000 (Flask's own built-in default) when unset, so leaving this
# commented out changes nothing. config.conf is baked into the Docker image at
# build time, not bind-mounted, so this must be set before
# `docker compose build` to take effect.
# MAX_FORM_MEMORY_SIZE = 500000

# --- Reverse-proxy deployment (recommended for production) ---------------------
# Set behind_proxy = true when a TLS-terminating reverse proxy (nginx/Caddy)
# sits in front and Hashview serves plain HTTP on localhost (run it with
# --no-ssl). The app then trusts exactly ONE proxy hop's X-Forwarded-For/Proto/
# Host (so the audit log records the real client IP and cookies/URLs are HTTPS)
# and marks session cookies Secure. See install/deploy/ for nginx/Caddy configs.
# Keep SERVER_NAME above on the PUBLIC host:port the proxy listens on (e.g.
# FQDN:8443). Leave false for the default direct-TLS :8443 deployment. Unset =
# false, so this changes nothing until you opt in.
# behind_proxy = false
# Address the app binds when run with --no-ssl. Keep bind_host on loopback so the
# plain-HTTP origin is never world-reachable; point your proxy's upstream here.
# bind_host = 127.0.0.1
# bind_port = 5000

[database]
host = localhost
username = username
password = password
# Connection-pool sizing. Unset, Hashview uses pool_size=10 / max_overflow=20,
# i.e. up to 30 concurrent database connections for this process. Raise them if
# you run many agents plus many concurrent operators, and keep the total well
# below MySQL's max_connections (151 by default) so other clients -- and a
# second Hashview process -- can still connect.
#
# Raising these does not fix a stall caused by one long-running transaction; it
# only buys time before the pool empties. See hashview/config.py.
# pool_size = 10
# max_overflow = 20

[SMTP]
server = smtp.example.com
port = 25
use_tls = False
username = 
password = 
default_sender = 