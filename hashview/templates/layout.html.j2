<!DOCTYPE html>
<html lang="en" data-glow="subtle" data-scanlines="{% block scanlines %}on{% endblock %}" data-density="comfortable"
      {# Bake any explicit (non-auto) stored theme so there's no flash and it works without JS; 'auto' and anonymous fall back to dark and are resolved client-side. Values are constrained by the set_theme allowlist, so no separate list is duplicated here. #}
      data-theme="{% if current_user.is_authenticated and current_user.theme and current_user.theme != 'auto' %}{{ current_user.theme }}{% else %}dark{% endif %}"
      {# An empty/absent data-theme-pref is the intentional signal for the pre-paint script to fall back to localStorage/OS (anonymous pages). Do not emit a default here. #}
      data-theme-pref="{% if current_user.is_authenticated %}{{ current_user.theme }}{% else %}{% endif %}">
{% from "icons.html.j2" import icon %}
<head>
    <script>/* sidebar collapse pref — applied before paint to avoid a flash of the expanded rail */(function(){try{if(localStorage.getItem('hv_sidebar_collapsed')==='1'){document.documentElement.setAttribute('data-sidebar','collapsed');}}catch(e){}})();</script>
    <script>/* theme — applied before paint to avoid a flash of the wrong theme */(function(){try{var el=document.documentElement;var pref=el.getAttribute('data-theme-pref');if(!pref){pref=localStorage.getItem('hv_theme')||'auto';}var resolved=pref;if(pref==='auto'){resolved=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches)?'light-paper':'dark';}el.setAttribute('data-theme',resolved);}catch(e){}})();</script>
    <meta charset="UTF-8">
    <title>{% block title %}Hashview v{{ get_application_version() }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" type="image/svg+xml" href="{{ url_for('static', filename='favicon.svg') }}">

    <link type="text/css" rel="stylesheet" href="{{ url_for('static', filename='main.css') }}">

    {# --- Phosphor Console design system (self-hosted) --- #}
    <link rel="stylesheet" href="{{ url_for('static', filename='fonts/plex.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/phosphor.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/phosphor-app.css') }}">

    {% block head %}{% endblock %}
</head>
<body>
    <div class="scanlines"></div>

    {% if current_user.is_authenticated %}
    {# ---------- authenticated app shell: sidebar + topbar + page ---------- #}
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark">#</div>
                <div>
                    <div class="brand-name">hash<b>view</b><span class="cursor-blink"></span></div>
                    <div class="brand-sub">v{{ get_application_version() }} · recovery console</div>
                </div>
            </div>

            {% include "_console_nav.html.j2" %}

            <div class="sidebar-foot">
                {% if agent_stats is defined %}
                <div class="agent-mini" title="{{ agent_stats.up }} up (running/idle) · {{ agent_stats.down }} offline/disconnected · {{ agent_stats.speed }} from running agents">
                    <span class="dot-led {{ 'on' if agent_stats.up else 'off' }}"></span>
                    <span><b>{{ agent_stats.up }}</b> up · <b>{{ agent_stats.down }}</b> down · <b>{{ agent_stats.speed }}</b></span>
                </div>
                {% endif %}
                <div class="user-chip">
                    <div class="avatar" onclick="document.getElementById('account-settings-modal').showModal()" title="Account settings" style="cursor:pointer;">{{ current_user.first_name[0]|upper }}{{ current_user.last_name[0]|upper }}</div>
                    <div style="flex:1; min-width:0;">
                        <a href="#" class="nm" onclick="document.getElementById('account-settings-modal').showModal(); return false;" title="Account settings" style="text-decoration:none; color:var(--text); display:block; cursor:pointer;">{{ current_user.first_name }} {{ current_user.last_name }}</a>
                        <div class="rl">{{ 'admin' if current_user.admin else 'operator' }}</div>
                    </div>
                    <a href="{{ url_for('users.logout') }}" title="Log out" style="color:var(--text-mute); display:flex; align-items:center;">{{ icon('power', size=16) }}</a>
                </div>
            </div>
        </aside>

        <div class="main">
            <div class="topbar">
                <button class="icon-btn" id="hv-sidebar-toggle" type="button" aria-label="Toggle sidebar" title="Collapse / expand sidebar" onclick="hvToggleSidebar()">{{ icon('list', size=18) }}</button>
                <div class="topbar-spacer"></div>
                {% if job_queue is defined %}
                <div class="top-stat">
                    {% if job_queue.running %}<span class="dot-led run"></span>{% endif %}
                    <b style="color:{{ 'var(--primary)' if job_queue.running else 'var(--text)' }};">{{ job_queue.running }}</b> running
                </div>
                <div class="top-stat"><b style="color:var(--amber);">{{ job_queue.queued }}</b> queued</div>
                {% endif %}
                <div class="top-stat" style="padding-left:16px; border-left:1px solid var(--border);">{{ icon('clock', size=14) }} <span class="clock" id="hv-clock">--:--:--</span></div>
            </div>

            <div class="page">
                {% include "_flash.html.j2" %}
                {% block header %}{% endblock %}
                {% block content %}{% endblock %}
            </div>
        </div>
    </div>

    {# ---- account settings modal (opened from the sidebar name / avatar) ---- #}
    {% set as_handle = current_user.email_address.split('@')[0] %}
    {% set as_role = 'administrator' if current_user.admin else 'operator' %}
    {% set as_key = current_user.api_key or '' %}
    {% set as_mask = (as_key[:8] ~ '••••••••••' ~ as_key[-4:]) if as_key else 'No key set' %}
    <style>
    #account-settings-modal .as-sec { font-family:var(--mono); font-size:9.5px; letter-spacing:1px; text-transform:uppercase; color:var(--text-mute); margin:22px 0 12px; display:flex; align-items:center; gap:10px; }
    #account-settings-modal .as-sec::after { content:""; flex:1; height:1px; background:var(--border-soft); }
    </style>
    <dialog class="hv-dialog" id="account-settings-modal" style="max-width:660px; width:96vw;">
        <div class="hv-dialog-head">
            {{ icon('users', size=16) }}
            <div style="line-height:1.2;">
                <h3 style="margin:0;">Account Settings</h3>
                <div class="mono" style="font-size:10px; letter-spacing:0.5px; color:var(--text-mute); margin-top:3px;">{{ as_handle }} · {{ as_role }}</div>
            </div>
            <button class="icon-btn" onclick="this.closest('dialog').close()" aria-label="Close" style="margin-left:auto;">{{ icon('x', size=15) }}</button>
        </div>
        <form method="POST" action="{{ url_for('users.profile') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="next" value="{{ request.path }}">
            <div class="hv-dialog-body" style="max-height:74vh; overflow-y:auto;">
                {# identity strip #}
                <div style="display:flex; align-items:center; gap:14px;">
                    <span style="flex:none; width:46px; height:46px; border-radius:11px; display:inline-flex; align-items:center; justify-content:center; font-weight:700; color:var(--primary); border:1px solid var(--primary-dim); background:rgba(var(--primary-rgb),0.08);">{{ current_user.first_name[:1]|upper }}{{ current_user.last_name[:1]|upper }}</span>
                    <div style="line-height:1.3; min-width:0;">
                        <div style="font-weight:600; color:var(--text);">{{ current_user.first_name }} {{ current_user.last_name }}</div>
                        <div class="mono" style="font-size:11px; color:var(--text-mute); margin-top:2px;">{{ as_handle }} · {{ as_role }}</div>
                    </div>
                </div>

                {# IDENTITY #}
                <div class="as-sec">Identity</div>
                <div class="grid" style="grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="field" style="margin-bottom:0;">
                        <label class="field-label" for="as-first">First name <span class="req">*</span></label>
                        <input class="input" type="text" name="first_name" id="as-first" value="{{ current_user.first_name }}" autocomplete="off" required>
                    </div>
                    <div class="field" style="margin-bottom:0;">
                        <label class="field-label" for="as-last">Last name <span class="req">*</span></label>
                        <input class="input" type="text" name="last_name" id="as-last" value="{{ current_user.last_name }}" autocomplete="off" required>
                    </div>
                </div>
                <div class="field" style="margin-top:16px; margin-bottom:0;">
                    <label class="field-label" for="as-email">Email address <span class="req">*</span></label>
                    <div style="display:flex; gap:8px; align-items:stretch;">
                        <input class="input" type="email" name="email" id="as-email" value="{{ current_user.email_address }}" autocomplete="off" required style="flex:1;">
                        <a class="btn" href="{{ url_for('users.send_test_email', next=request.path) }}" role="button" style="flex:none;">{{ icon('mail', size=15) }} Test email</a>
                    </div>
                </div>

                {# API ACCESS #}
                <div class="as-sec">API access</div>
                <div class="field" style="margin-bottom:0;">
                    <label class="field-label">Personal API key</label>
                    <div style="display:flex; gap:8px; align-items:stretch;">
                        <div style="position:relative; flex:1; min-width:0;">
                            <input class="input mono" id="as-apikey" type="text" data-full="{{ as_key }}" data-mask="{{ as_mask }}" value="{{ as_mask }}" readonly style="padding-right:38px; width:100%;">
                            <button type="button" class="icon-btn" onclick="hvApiReveal()" title="Show / hide" style="position:absolute; right:4px; top:50%; transform:translateY(-50%); border:0; background:none;">{{ icon('eye', size=15) }}</button>
                        </div>
                        <button type="button" class="btn" onclick="hvApiCopy(this)" style="flex:none;">{{ icon('copy', size=15) }} Copy</button>
                        <a class="btn" href="{{ url_for('users.generate_api_key', next=request.path) }}" role="button" style="flex:none;">{{ icon('refresh', size=15) }} Generate</a>
                    </div>
                    <span class="field-hint" style="margin-top:8px; display:block;">Used to authenticate against the Hashview REST API. Regenerating immediately revokes the previous key.</span>
                </div>

                {# PUSHOVER — only when the channel is enabled instance-wide #}
                {% if notify_channels.pushover %}
                <div class="as-sec">Pushover notifications</div>
                <div class="grid" style="grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="field" style="margin-bottom:0;">
                        <label class="field-label" for="as-pu-key">User key</label>
                        <input class="input mono" type="text" name="pushover_user_key" id="as-pu-key" value="{{ current_user.pushover_user_key or '' }}" placeholder="u…" autocomplete="off">
                    </div>
                    <div class="field" style="margin-bottom:0;">
                        <label class="field-label" for="as-pu-app">App API token</label>
                        <input class="input mono" type="text" name="pushover_app_id" id="as-pu-app" value="{{ current_user.pushover_app_id or '' }}" placeholder="a…" autocomplete="off">
                    </div>
                </div>
                <div style="margin-top:12px;">
                    <a class="btn" href="{{ url_for('users.send_test_pushover', next=request.path) }}" role="button">{{ icon('bell', size=15) }} Send test notification</a>
                </div>
                <span class="field-hint" style="margin-top:8px; display:block;">Enter both your Pushover user key and an app token to enable push alerts.</span>
                {% endif %}

                {# SLACK — only when the channel is enabled instance-wide #}
                {% if notify_channels.slack %}
                <div class="as-sec">Slack notifications</div>
                <div class="field" style="margin-bottom:0;">
                    <label class="field-label" for="as-slack-id">Slack Member ID</label>
                    <input class="input mono" type="text" name="slack_id" id="as-slack-id" value="{{ current_user.slack_id or '' }}" placeholder="U0123ABCD" autocomplete="off">
                </div>
                <div style="margin-top:12px;">
                    <a class="btn" href="{{ url_for('users.send_test_slack', next=request.path) }}" role="button">{{ icon('slack', size=15) }} Send test Slack</a>
                </div>
                <span class="field-hint" style="margin-top:8px; display:block;">In Slack: your profile → ⋮ → Copy member ID (looks like U0123ABCD).</span>
                {% endif %}

                {# ADMINISTRATIVE NOTIFICATIONS — admins only (agent-error alerts) #}
                {% if current_user.admin %}
                <div class="as-sec">Administrative notifications</div>
                <label style="display:flex; align-items:center; gap:12px; cursor:pointer;">
                    <span class="switch"><input type="checkbox" name="admin_notifications_enabled" id="as-admin-notif" role="switch" onchange="hvSyncAdminNotif()"{% if current_user.admin_notifications_enabled %} checked{% endif %}><span class="track"></span></span>
                    <span>
                        <span style="display:block; font-size:13px; color:var(--text);">Receive administrative notifications</span>
                        <span class="field-hint" style="margin-top:2px;">Hashview agent error alerts. Pick the channels below.</span>
                    </span>
                </label>
                <div id="as-admin-notif-channels" style="margin-top:14px; display:{{ 'block' if current_user.admin_notifications_enabled else 'none' }};">
                    {% if notify_channels.email or notify_channels.pushover or notify_channels.slack %}
                    {# Pick which enabled channel(s) deliver administrative alerts. Columns
                       reflect the instance master switches (Settings -> Notifications). #}
                    <table class="an-pref">
                        <thead>
                            <tr>
                                <th></th>
                                {% if notify_channels.email %}<th>{{ icon('mail', size=16) }}<span>Email</span></th>{% endif %}
                                {% if notify_channels.pushover %}<th>{{ icon('bell', size=16) }}<span>Pushover</span></th>{% endif %}
                                {% if notify_channels.slack %}<th>{{ icon('slack', size=16) }}<span>Slack</span></th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="an-row-title">{{ icon('shield', size=16) }} Admin alerts</div>
                                    <div class="an-row-sub">Hashview agent errors &amp; system health{% if notify_channels.slack %} · Slack posts to the admin room{% endif %}</div>
                                </td>
                                {% if notify_channels.email %}<td><label class="an-box"><input type="checkbox" name="admin_notify_email"{% if current_user.admin_notify_email %} checked{% endif %}>{{ icon('check', size=16) }}</label></td>{% endif %}
                                {% if notify_channels.pushover %}<td><label class="an-box"><input type="checkbox" name="admin_notify_pushover"{% if current_user.admin_notify_pushover %} checked{% endif %}>{{ icon('check', size=16) }}</label></td>{% endif %}
                                {% if notify_channels.slack %}<td><label class="an-box"><input type="checkbox" name="admin_notify_slack"{% if current_user.admin_notify_slack %} checked{% endif %}>{{ icon('check', size=16) }}</label></td>{% endif %}
                            </tr>
                        </tbody>
                    </table>
                    <div class="field-hint" style="margin-top:8px;">{{ icon('info', size=12) }} An event with no channel selected won't notify you at all.</div>
                    {% else %}
                    <span class="field-hint">No notification channels are enabled instance-wide.</span>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            <div class="hv-dialog-foot">
                <button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button>
                <button type="submit" class="btn btn-primary">{{ icon('check', size=15) }} Update profile</button>
            </div>
        </form>
    </dialog>
    <script>
    function hvApiReveal() {
        var i = document.getElementById('as-apikey'); if (!i) return;
        var full = i.getAttribute('data-full'); if (!full) return;
        i.value = (i.value === full) ? i.getAttribute('data-mask') : full;
    }
    function hvApiCopy(btn) {
        var i = document.getElementById('as-apikey'); if (!i) return;
        var full = i.getAttribute('data-full'); if (!full) return;
        // Momentary "Copied!" confirmation on the button so the user knows the
        // key made it to the clipboard (issue #303).
        function flash() {
            if (!btn) return;
            if (btn._copyT) { clearTimeout(btn._copyT); } else { btn._copyHTML = btn.innerHTML; }
            btn.innerHTML = '✓ Copied!';
            btn.style.color = 'var(--primary)';
            btn._copyT = setTimeout(function () {
                btn.innerHTML = btn._copyHTML;
                btn.style.color = '';
                btn._copyT = null;
            }, 1500);
        }
        function legacy() {
            var was = i.value; i.value = full; i.select();
            try { document.execCommand('copy'); } catch (e) {}
            i.value = was; if (i.blur) { i.blur(); }
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(full).then(flash, function () { legacy(); flash(); });
        } else {
            legacy(); flash();
        }
    }
    // After regenerating the key, generate_api_key redirects back with
    // ?apikey_generated=1 — reopen the account modal and reveal the new key
    // (the page re-rendered with it), then strip the marker from the URL.
    document.addEventListener('DOMContentLoaded', function () {
        var params = new URLSearchParams(window.location.search);
        if (!params.has('apikey_generated')) return;
        var modal = document.getElementById('account-settings-modal');
        if (modal) { try { modal.showModal(); } catch (e) { modal.setAttribute('open', ''); } }
        var i = document.getElementById('as-apikey');
        if (i) { var full = i.getAttribute('data-full'); if (full) { i.value = full; } }
        params.delete('apikey_generated');
        var qs = params.toString();
        history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
    });
    // Reveal the per-channel admin-notification options only when the master
    // "Receive administrative notifications" switch is on (admins only).
    function hvSyncAdminNotif() {
        var on = document.getElementById('as-admin-notif');
        var box = document.getElementById('as-admin-notif-channels');
        if (box) box.style.display = (on && on.checked) ? 'block' : 'none';
    }
    </script>

    {% else %}
    {# ---------- unauthenticated: centered card (login / password reset) ---------- #}
    <div class="auth-body">
        <div class="auth-wrap">
            <div class="brand-lg"><span class="brand-mark">#</span><span>hash<b>view</b></span></div>
            {% include "_flash.html.j2" %}
            {% block content_anon %}{% endblock %}
        </div>
    </div>
    {% endif %}

    <script>
    (function () {
        var el = document.getElementById('hv-clock');
        if (!el) return;
        function pad(n) { return String(n).padStart(2, '0'); }
        function tick() { var d = new Date(); el.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()); }
        tick();
        setInterval(tick, 1000);
    })();
    </script>
    <script>
    // Collapse / expand the sidebar to an icon-only rail; persist the choice.
    function hvToggleSidebar() {
        var collapsed = document.documentElement.getAttribute('data-sidebar') === 'collapsed';
        if (collapsed) {
            document.documentElement.removeAttribute('data-sidebar');
            try { localStorage.setItem('hv_sidebar_collapsed', '0'); } catch (e) {}
        } else {
            document.documentElement.setAttribute('data-sidebar', 'collapsed');
            try { localStorage.setItem('hv_sidebar_collapsed', '1'); } catch (e) {}
        }
    }

    // Disable a wizard step's Next/submit button until its form's required fields
    // are satisfied (native HTML5 constraint validation). Re-checks on every input
    // /change; server-side validation remains the source of truth.
    function hvGateNext(form, btn) {
        if (!form || !btn) return;
        function sync() { btn.disabled = !form.checkValidity(); }
        form.addEventListener('input', sync);
        form.addEventListener('change', sync);
        sync();
    }
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
